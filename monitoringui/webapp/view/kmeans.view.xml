<mvc:View
  controllerName="pwc.monitoring.monitoringui.controller.kmeans"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Page title="SAP Basis Intelligence">
<headerContent>
      <Button
        id="btnGoSecurity"
        text="Security Events"
        icon="sap-icon://shield"
        press=".onGoSecurity"/>

      <Button
        text="System Health"
        icon="sap-icon://sys-monitor"
        press=".onGoSystemHealth"/>

      <Button
        text="AI Risk Monitor"
        icon="sap-icon://ai"
        press=".goRisk"/>
    </headerContent>
    <content>
   
      <VBox class="sapUiContentPadding aiSearchPage" width="100%">

        <VBox class="searchHeroSection sapUiMediumMarginBottom" alignItems="Center" width="100%">
          <core:Icon
            src="sap-icon://ai"
            size="2.5rem"
            class="heroAiIcon sapUiSmallMarginBottom"/>

          <Title
            text="SAP Basis Intelligence Search"
            level="H2"
            class="sapUiSmallMarginBottom"/>

          <Text
            text="Find related T-Codes, programs, descriptions, clusters, and similarity-based recommendations."
            class="heroSubtitle sapUiSmallMarginBottom"/>

          <HBox
            width="100%"
            justifyContent="Center"
            alignItems="Center"
            class="sapUiMediumMarginTop"
            wrap="Wrap">

            <SearchField
              id="tcodeInput"
              width="32rem"
              placeholder="Search by T-Code or keyword..."
              search=".onSearch"
              class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>

            <Button
              id="searchBtn"
              text="Search"
              icon="sap-icon://search"
              type="Emphasized"
              press=".onSearch"
              class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>

            <Button
              id="favoritesBtn"
              text="Favorites"
              icon="sap-icon://list"
              type="Transparent"
              press=".onToggleFavoritesPanel"
              class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>

            <Button
              id="startTourBtn"
              text="Tour"
              icon="sap-icon://sys-help"
              type="Transparent"
              press=".onStartTourPress"
              class="sapUiTinyMarginBottom"/>
          </HBox>

          <VBox id="quickSuggestionsBox" class="sapUiSmallMarginTop" alignItems="Center">
            <Text
              text="Quick suggestions"
              class="subtleText sapUiTinyMarginBottom"/>

            <HBox wrap="Wrap" justifyContent="Center">
              <Button text="SU01" type="Transparent" press=".onQuickSuggestionPress" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
              <Button text="PFCG" type="Transparent" press=".onQuickSuggestionPress" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
              <Button text="ST22" type="Transparent" press=".onQuickSuggestionPress" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
              <Button text="SM37" type="Transparent" press=".onQuickSuggestionPress" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
              <Button text="SCC4" type="Transparent" press=".onQuickSuggestionPress" class="sapUiTinyMarginBottom"/>
            </HBox>
          </VBox>

          <VBox
            id="recentSearchesBox"
            class="sapUiSmallMarginTop"
            alignItems="Center"
            visible="{= ${searchModel>/recentSearches}.length > 0 }">

            <HBox alignItems="Center" class="sapUiTinyMarginBottom">
              <Text text="Recent searches" class="subtleText sapUiTinyMarginEnd"/>
              <Button
                text="Clear All"
                type="Transparent"
                press=".onClearRecentSearches"/>
            </HBox>

            <List
              items="{searchModel>/recentSearches}"
              width="32rem"
              class="sapUiTinyMarginTop">

              <CustomListItem>
                <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%">
                  <HBox alignItems="Center">
                    <core:Icon
                      src="sap-icon://history"
                      size="0.9rem"
                      class="sapUiTinyMarginEnd"/>
                    <Text text="{searchModel>text}"/>
                  </HBox>

                  <HBox alignItems="Center">
                    <Button
                      icon="sap-icon://search"
                      type="Transparent"
                      tooltip="Reuse search"
                      press=".onRecentSearchPress"
                      class="sapUiTinyMarginEnd"/>

                    <Button
                      icon="sap-icon://decline"
                      type="Transparent"
                      tooltip="Remove from history"
                      press=".onRemoveRecentSearch"/>
                  </HBox>
                </HBox>
              </CustomListItem>
            </List>
          </VBox>
        </VBox>

        <Panel
          id="favoritesPanel"
          expandable="true"
          expanded="{favModel>/showFavorites}"
          visible="{= ${favModel>/favorites}.length > 0 }"
          headerText="My Favorites"
          class="styledPanel sapUiMediumMarginBottom">

          <VBox class="sapUiMediumMargin">

            <HBox
              width="100%"
              justifyContent="SpaceBetween"
              alignItems="Center"
              class="sapUiSmallMarginBottom">

              <HBox alignItems="Center">
                <core:Icon
                  src="sap-icon://favorite"
                  size="1rem"
                  class="cardIconPurple sapUiTinyMarginEnd"/>
                <Title text="Saved T-Codes" level="H5"/>
              </HBox>

              <HBox alignItems="Center">
                <ObjectStatus
                  text="{= (${favModel>/favorites}.length || 0) + ' favorites'}"
                  state="Information"
                  class="sapUiSmallMarginEnd"/>

                <Button
                  text="Export Favorites Excel"
                  icon="sap-icon://excel-attachment"
                  type="Transparent"
                  press=".onExportFavoritesExcel"/>
              </HBox>

            </HBox>

            <List items="{favModel>/favorites}">
              <CustomListItem>
                <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%">
                  <VBox width="70%">
                    <HBox alignItems="Center">
                      <core:Icon
                        src="sap-icon://favorite"
                        class="sapUiTinyMarginEnd"/>
                      <Title text="{favModel>tcode}" level="H6"/>
                    </HBox>
                    <Text text="{favModel>desc}" wrapping="true"/>
                  </VBox>

                  <HBox alignItems="Center">
                    <Button
                      icon="sap-icon://copy"
                      type="Transparent"
                      tooltip="Copy T-Code"
                      press=".onCopyFavoriteTcode"
                      class="sapUiTinyMarginEnd"/>

                    <ObjectStatus
                      text="{favModel>cluster}"
                      state="Information"
                      class="sapUiTinyMarginEnd"/>

                    <Button
                      icon="sap-icon://decline"
                      type="Transparent"
                      tooltip="Remove from favorites"
                      press=".onRemoveFavorite"
                      class="favoriteRemoveBtn"/>
                  </HBox>
                </HBox>
              </CustomListItem>
            </List>
          </VBox>
        </Panel>

        <Panel
  id="resultsPanel"
  headerText="Recommendation Results"
  class="styledPanel sapUiMediumMarginBottom">

          <VBox class="sapUiMediumMargin">

            <HBox alignItems="Center" class="sapUiSmallMarginBottom">
              <core:Icon
                src="sap-icon://search"
                size="1.1rem"
                class="cardIconBlue sapUiTinyMarginEnd"/>
              <Title text="AI Recommendations" level="H5"/>
            </HBox>

            <Text
              text="Explore ranked matches returned by the recommendation engine."
              class="subtleText sapUiSmallMarginBottom"/>

            <Panel
              id="resultFilterPanel"
              headerText="T-Code Result Filters"
              expandable="true"
              expanded="true"
              class="styledPanel sapUiSmallMarginBottom">

              <VBox class="sapUiMediumMargin">

                <HBox
                  width="100%"
                  alignItems="Center"
                  justifyContent="SpaceBetween"
                  wrap="Wrap">

                  <HBox alignItems="Center" wrap="Wrap">
                    <SearchField
                      id="sfTcodeResultFilter"
                      width="24rem"
                      value="{recModel>/filterText}"
                      liveChange=".onResultFilterChange"
                      placeholder="Filter by T-Code, program, description, cluster..."
                      class="sapUiSmallMarginEnd sapUiTinyMarginBottom"/>

                    <Button
                      text="Clear"
                      icon="sap-icon://clear-filter"
                      press=".onClearResultFilter"
                      class="sapUiTinyMarginBottom"/>
                  </HBox>

                  <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                    <ObjectStatus
                      text="{= (${recModel>/rows}.length || 0) + ' filtered results'}"
                      state="Information"
                      class="sapUiSmallMarginEnd"/>

                    <Button
                      text="Export Excel"
                      icon="sap-icon://excel-attachment"
                      type="Emphasized"
                      press=".onExportFilteredResultsExcel"
                      class="sapUiTinyMarginEnd"/>

                    <Button
                      text="Export CSV"
                      icon="sap-icon://download"
                      type="Transparent"
                      press=".onExportFilteredResultsCsv"/>
                  </HBox>

                </HBox>

              </VBox>
            </Panel>

            <Table
              id="resultTable"
              items="{recModel>/rows}"
              growing="true"
              growingThreshold="15"
              class="niceTable">

              <headerToolbar>
                <Toolbar id="tbTcodeResults">
                  <Title text="T-Code Recommendations" level="H2"/>
                  <ToolbarSpacer/>
                  <ObjectStatus
                    text="{= (${recModel>/rows}.length || 0) + ' items'}"
                    state="Information"/>
                </Toolbar>
              </headerToolbar>

              <columns>
                <Column width="6rem"><Text text="Rank"/></Column>
                <Column width="10rem"><Text text="Code"/></Column>
                <Column width="5rem" hAlign="Center"><Text text="Copy"/></Column>
                <Column width="5rem" hAlign="Center"><Text text="Fav"/></Column>
                <Column width="12rem"><Text text="Program"/></Column>
                <Column width="24rem"><Text text="Description"/></Column>
                <Column width="8rem"><Text text="Cluster"/></Column>
                <Column width="10rem" hAlign="End"><Text text="Similarity"/></Column>
                <Column width="10rem" hAlign="Center"><Text text="Actions"/></Column>
              </columns>

              <items>
                <ColumnListItem class="tableRowHover">
                  <cells>
                    <ObjectNumber number="{recModel>rank}"/>
                    <ObjectIdentifier title="{recModel>tcode}"/>

                    <Button
                      icon="sap-icon://copy"
                      type="Transparent"
                      tooltip="Copy T-Code"
                      press=".onCopyTcode"/>

                    <Button
                      icon="{= ${recModel>isFavorite} ? 'sap-icon://favorite' : 'sap-icon://unfavorite' }"
                      type="Transparent"
                      tooltip="Toggle favorite"
                      press=".onToggleFavorite"
                      class="{= ${recModel>isFavorite} ? 'favoriteHeartBtn favoriteHeartActive' : 'favoriteHeartBtn favoriteHeartInactive' }"/>

                    <Text text="{recModel>program}" wrapping="true"/>
                    <Text text="{recModel>desc}" wrapping="true"/>
                    <ObjectStatus text="{recModel>cluster}" state="Information"/>
                    <ObjectNumber number="{recModel>similarity}"/>

                    <HBox justifyContent="Center" alignItems="Center" wrap="NoWrap">
                      <Button
                        icon="sap-icon://inspect"
                        type="Transparent"
                        tooltip="View Details"
                        press=".onViewDetails"
                        class="sapUiTinyMarginEnd"/>

                      <Button
                        icon="sap-icon://world"
                        type="Transparent"
                        tooltip="Search on Google"
                        press=".onOpenDocumentation"/>
                    </HBox>
                  </cells>
                </ColumnListItem>
              </items>

            </Table>
          </VBox>
        </Panel>

      </VBox>
    </content>

  </Page>
</mvc:View>