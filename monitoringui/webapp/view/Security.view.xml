<mvc:View
  controllerName="pwc.monitoring.monitoringui.controller.Security"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:viz="sap.viz.ui5.controls"
  xmlns:vizData="sap.viz.ui5.data"
  xmlns:vizFeeds="sap.viz.ui5.controls.common.feeds">

  <Page
    title="Security Behaviour Monitoring (UEBA)"
    class="securityPage"
    showNavButton="true"
    navButtonPress=".onBack">

    <headerContent>
      <Button
        text="Refresh"
        icon="sap-icon://refresh"
        type="Emphasized"
        press=".onRefresh"/>

      <Button
        text="System Health"
        icon="sap-icon://sys-monitor"
        press=".onGoSystemHealth"/>

      <Button
        text="AI Risk Monitor"
        icon="sap-icon://ai"
        press=".goRisk"/>

      <Button
        text="Basis Intelligence"
        icon="sap-icon://lightbulb"
        type="Accept"
        press=".goKmeans"/>
    </headerContent>

    <content>
      <VBox class="sapUiContentPadding">

        <MessageStrip
          text="Monitor risky security behaviour, anomalous access activity, suspicious login patterns, and user/client events."
          type="Warning"
          showIcon="true"
          class="sapUiSmallMarginBottom"/>

        <HBox
          width="100%"
          justifyContent="SpaceAround"
          wrap="Wrap"
          class="sapUiMediumMarginBottom">

          <VBox
            id="secKpiHigh"
            class="kpiCard kpiCrimson"
            alignItems="Center"
            justifyContent="Center">
            <core:Icon src="sap-icon://warning2" size="1.6rem" class="kpiIcon"/>
            <Title text="High Behaviour Risk" level="H6" class="kpiTitle"/>
            <ObjectNumber
              number="{security>/kpi/high}"
              state="Error"
              class="kpiNumber"/>
          </VBox>

          <VBox
            id="secKpiMedium"
            class="kpiCard kpiGold"
            alignItems="Center"
            justifyContent="Center">
            <core:Icon src="sap-icon://alert" size="1.6rem" class="kpiIcon"/>
            <Title text="Medium Behaviour Risk" level="H6" class="kpiTitle"/>
            <ObjectNumber
              number="{security>/kpi/medium}"
              state="Warning"
              class="kpiNumber"/>
          </VBox>

          <VBox
            id="secKpiLow"
            class="kpiCard kpiCyan"
            alignItems="Center"
            justifyContent="Center">
            <core:Icon src="sap-icon://activity-individual" size="1.6rem" class="kpiIcon"/>
            <Title text="Low Behaviour Risk" level="H6" class="kpiTitle"/>
            <ObjectNumber
              number="{security>/kpi/low}"
              state="Success"
              class="kpiNumber"/>
          </VBox>

          <VBox
            id="secKpiAll"
            class="kpiCard kpiSlate"
            alignItems="Center"
            justifyContent="Center">
            <core:Icon src="sap-icon://list" size="1.6rem" class="kpiIcon"/>
            <Title text="Filtered Events" level="H6" class="kpiTitle"/>
            <ObjectNumber
              number="{= ${security>/rows} ? ${security>/rows}.length : 0 }"
              state="Information"
              class="kpiNumber"/>
          </VBox>

        </HBox>

        <HBox
          wrap="Wrap"
          justifyContent="Start"
          width="100%"
          class="sapUiSmallMarginBottom">

          <HBox
            id="secMiniLogin"
            class="miniStatCard miniLoginSec"
            alignItems="Center">
            <core:Icon src="sap-icon://log" size="1rem" class="miniStatIcon sapUiTinyMarginEnd"/>
            <Text text="{= 'LOGIN: ' + (${security>/kpi/loginCount} || 0) }" class="miniStatText"/>
          </HBox>

          <HBox
            id="secMiniToken"
            class="miniStatCard miniTokenSec"
            alignItems="Center">
            <core:Icon src="sap-icon://key" size="1rem" class="miniStatIcon sapUiTinyMarginEnd"/>
            <Text text="{= 'TOKEN: ' + (${security>/kpi/tokenCount} || 0) }" class="miniStatText"/>
          </HBox>

          <HBox
            id="secMiniClient"
            class="miniStatCard miniClientSec"
            alignItems="Center">
            <core:Icon src="sap-icon://shield" size="1rem" class="miniStatIcon sapUiTinyMarginEnd"/>
            <Text text="{= 'CLIENT: ' + (${security>/kpi/clientCount} || 0) }" class="miniStatText"/>
          </HBox>

          <HBox
            id="secMiniOther"
            class="miniStatCard miniOtherSec"
            alignItems="Center">
            <core:Icon src="sap-icon://activity-items" size="1rem" class="miniStatIcon sapUiTinyMarginEnd"/>
            <Text text="{= 'OTHER: ' + (${security>/kpi/otherCount} || 0) }" class="miniStatText"/>
          </HBox>

        </HBox>

        <FlexBox
          width="100%"
          renderType="Bare"
          wrap="Wrap"
          justifyContent="SpaceBetween"
          class="sapUiMediumMarginBottom">

          <Panel class="styledPanel chartPanel">
            <layoutData>
              <FlexItemData growFactor="1" baseSize="48%"/>
            </layoutData>

            <VBox class="sapUiMediumMargin">
              <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                <core:Icon src="sap-icon://pie-chart" size="1.1rem" class="cardIconCrimson sapUiTinyMarginEnd"/>
                <Title text="Events by User" level="H5"/>
              </HBox>

              <Text
                text="Distribution of security-relevant events across users."
                class="subtleText sapUiTinyMarginBottom"/>

              <viz:VizFrame
                id="idUserPie"
                width="100%"
                height="420px"
                vizType="pie"
                uiConfig="{applicationSet:'fiori'}"
                selectData=".onUserPieSelect"
                vizProperties='{
                  "title": {
                    "visible": true,
                    "text": "Security Events Distribution by User",
                    "alignment": "center"
                  },
                  "plotArea": {
                    "dataLabel": {
                      "visible": true
                    },
                    "colorPalette": [
                      "#ef4444",
                      "#f59e0b",
                      "#3b82f6",
                      "#10b981",
                      "#8b5cf6",
                      "#14b8a6"
                    ]
                  },
                  "legend": {
                    "visible": true,
                    "layout": {
                      "position": "bottom"
                    }
                  }
                }'>

                <viz:dataset>
                  <vizData:FlattenedDataset data="{security>/userChart}">
                    <vizData:dimensions>
                      <vizData:DimensionDefinition
                        name="User"
                        value="{security>user}"/>
                    </vizData:dimensions>
                    <vizData:measures>
                      <vizData:MeasureDefinition
                        name="Events"
                        value="{security>count}"/>
                    </vizData:measures>
                  </vizData:FlattenedDataset>
                </viz:dataset>

                <viz:feeds>
                  <vizFeeds:FeedItem uid="size" type="Measure" values="Events"/>
                  <vizFeeds:FeedItem uid="color" type="Dimension" values="User"/>
                </viz:feeds>

              </viz:VizFrame>
            </VBox>
          </Panel>

          <Panel class="styledPanel chartPanel">
            <layoutData>
              <FlexItemData growFactor="1" baseSize="48%"/>
            </layoutData>

            <VBox class="sapUiMediumMargin">
              <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                <core:Icon src="sap-icon://line-chart" size="1.1rem" class="cardIconCyan sapUiTinyMarginEnd"/>
                <Title text="IAM Activity by Hour of Day" level="H5"/>
              </HBox>

              <Text
                text="Temporal trend of risky IAM-related activity across the day."
                class="subtleText sapUiTinyMarginBottom"/>

              <viz:VizFrame
                id="idRiskLine"
                width="100%"
                height="420px"
                vizType="line"
                uiConfig="{applicationSet:'fiori'}"
                vizProperties='{
                  "plotArea": {
                    "colorPalette": ["#2563eb"],
                    "dataLabel": {"visible": false},
                    "marker": {"visible": true, "size": 7}
                  },
                  "tooltip": {"visible": true},
                  "interaction": {"behaviorType": "default"},
                  "valueAxis": {"title": {"visible": true, "text": "Risk Events"}},
                  "categoryAxis": {"title": {"visible": true, "text": "Hour of Day"}},
                  "legend": {"visible": true},
                  "title": {"visible": false}
                }'>

                <viz:dataset>
                  <vizData:FlattenedDataset data="{security>/hourChart}">
                    <vizData:dimensions>
                      <vizData:DimensionDefinition
                        name="Time"
                        value="{security>time}"/>
                    </vizData:dimensions>
                    <vizData:measures>
                      <vizData:MeasureDefinition
                        name="Risk Events"
                        value="{security>count}"/>
                    </vizData:measures>
                  </vizData:FlattenedDataset>
                </viz:dataset>

                <viz:feeds>
                  <vizFeeds:FeedItem uid="valueAxis" type="Measure" values="Risk Events"/>
                  <vizFeeds:FeedItem uid="categoryAxis" type="Dimension" values="Time"/>
                </viz:feeds>

              </viz:VizFrame>
            </VBox>
          </Panel>

        </FlexBox>

        <HBox
          width="100%"
          justifyContent="End"
          class="sapUiMediumMarginTop sapUiMediumMarginBottom">
          <ObjectStatus
            title="Security Event Coverage"
            text="{security>/coverageText}"
            state="Success"
            icon="sap-icon://history"/>
        </HBox>

        <Panel
          headerText="Analyst Filters"
          expandable="true"
          expanded="true"
          class="styledPanel sapUiMediumMarginBottom">

          <VBox class="sapUiMediumMargin">

            <HBox alignItems="Center" class="sapUiSmallMarginBottom">
              <core:Icon src="sap-icon://filter" size="1rem" class="cardIconGold sapUiTinyMarginEnd"/>
              <Title text="Filtering &amp; Investigation" level="H5"/>
            </HBox>

            <SegmentedButton
              id="sbSecurityType"
              selectedKey="{security>/typeKey}"
              selectionChange=".onTypeChange"
              class="sapUiSmallMarginBottom">
              <items>
                <SegmentedButtonItem key="ALL" text="All"/>
                <SegmentedButtonItem key="LOGIN" text="Logins"/>
                <SegmentedButtonItem key="TOKEN" text="Tokens"/>
                <SegmentedButtonItem key="CLIENT" text="Client Auth"/>
                <SegmentedButtonItem key="OTHER" text="Other"/>
              </items>
            </SegmentedButton>

            <HBox class="sapUiSmallMarginTop" wrap="Wrap">
              <SearchField
                id="sfSecurityEmail"
                width="16rem"
                value="{security>/emailFilter}"
                liveChange=".onEmailChange"
                placeholder="Search User / Client"
                class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>

              <SearchField
                id="sfSecurityIp"
                width="12rem"
                value="{security>/ipFilter}"
                liveChange=".onIpChange"
                placeholder="Search IP"
                class="sapUiTinyMarginBottom"/>
            </HBox>

          </VBox>
        </Panel>

        <Panel class="styledPanel">
          <VBox class="sapUiMediumMargin">

            <HBox alignItems="Center" class="sapUiSmallMarginBottom">
              <core:Icon src="sap-icon://table-view" size="1.1rem" class="cardIconSlate sapUiTinyMarginEnd"/>
              <Title text="Security Events Table" level="H5"/>
            </HBox>

            <Text
              text="Detailed analyst view of anomalous events, user behaviour, IPs, clients, and calculated anomaly scores."
              class="subtleText sapUiSmallMarginBottom"/>

            <Table
              id="tblSecurity"
              items="{security>/rows}"
              growing="true"
              growingThreshold="25"
              class="niceTable">

              <headerToolbar>
                <Toolbar id="tbSecurityHeader">
                  <Title text="Security Events" level="H2"/>
                  <ToolbarSpacer/>
                  <ObjectStatus
                    text="{= (${security>/rows}.length || 0) + ' items'}"
                    state="Information"/>

                  <Button
                    text="Export Filtered Excel"
                    icon="sap-icon://excel-attachment"
                    type="Emphasized"
                    press=".onExportVisibleSecurityExcel"/>

                  <Button
                    text="Export PDF"
                    icon="sap-icon://pdf-attachment"
                    press=".onExportSecurityPdf"/>
                </Toolbar>
              </headerToolbar>

              <columns>
                <Column><Text text="Time"/></Column>
                <Column><Text text="User"/></Column>
                <Column><Text text="Risk"/></Column>
                <Column><Text text="Event Type"/></Column>
                <Column><Text text="IP"/></Column>
                <Column><Text text="Client"/></Column>
                <Column hAlign="End"><Text text="Score"/></Column>
              </columns>

              <items>
                <ColumnListItem class="tableRowHover">
                  <cells>
                    <Text text="{security>time}"/>
                    <Text text="{security>user}" wrapping="true"/>
                    <ObjectStatus
                      text="{security>risk}"
                      state="{security>riskState}"/>
                    <Text text="{security>eventType}"/>
                    <Text text="{security>ip}"/>
                    <Text text="{security>client}" wrapping="true"/>
                    <ObjectNumber
                      number="{
                        path:'security>anomalyScore',
                        type:'sap.ui.model.type.Float',
                        formatOptions:{
                          minFractionDigits:3,
                          maxFractionDigits:3
                        }
                      }"
                      emphasized="false"/>
                  </cells>
                </ColumnListItem>
              </items>

            </Table>

          </VBox>
        </Panel>

      </VBox>
    </content>

  </Page>
</mvc:View>