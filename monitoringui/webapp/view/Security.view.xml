<mvc:View
  controllerName="pwc.monitoring.monitoringui.controller.Security"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:viz="sap.viz.ui5.controls"
  xmlns:vizData="sap.viz.ui5.data"
  xmlns:vizFeeds="sap.viz.ui5.controls.common.feeds">

<Page
  title="Security Behaviour Monitoring (UEBA)"
  showNavButton="true"
  navButtonPress=".onBack">

  <headerContent>
    <Button text="Refresh" press=".onRefresh"/>
    <!-- <Button text="Data Changes" press=".onGoDataChanges"/> -->
    <Button text="System Health" press=".onGoSystemHealth" />
    <!--<Button text="Configuration Logs" press=".onGoLogs"/>-->
    <Button text="AI Risk Monitor" press=".goRisk"/>
  </headerContent>

  <content>

    <!-- KPI ROW -->
    <HBox
      width="100%"
      justifyContent="SpaceAround"
      wrap="Wrap"
      class="sapUiContentPadding sapUiMediumMarginBottom">

      <GenericTile header="High Behaviour Risk">
        <TileContent>
          <NumericContent value="{security>/kpi/high}"
            valueColor="Error"/>
        </TileContent>
      </GenericTile>

      <GenericTile header="Medium Behaviour Risk">
        <TileContent>
          <NumericContent value="{security>/kpi/medium}"
            valueColor="Critical"/>
        </TileContent>
      </GenericTile>

      <GenericTile header="Low Behaviour Risk">
        <TileContent>
          <NumericContent value="{security>/kpi/low}"
            valueColor="Neutral"/>
        </TileContent>
      </GenericTile>

      <GenericTile header="Total Events">
        <TileContent>
          <NumericContent
            value="{= (${security>/rows}.length || 0) }"
            valueColor="Good"/>
        </TileContent>
      </GenericTile>

    </HBox>

    <!-- FILTER PANEL -->
    <Panel
      headerText="Analyst Filters"
      expandable="true"
      expanded="true"
      class="sapUiContentPadding sapUiMediumMarginBottom">

      <VBox>

        <SegmentedButton
          selectedKey="ALL"
          selectionChange=".onTypeChange">
          <items>
            <SegmentedButtonItem key="ALL" text="All"/>
            <SegmentedButtonItem key="LOGIN" text="Logins"/>
            <SegmentedButtonItem key="TOKEN" text="Tokens"/>
            <SegmentedButtonItem key="CLIENT" text="Client Auth"/>
            <SegmentedButtonItem key="OTHER" text="Other"/>
          </items>
        </SegmentedButton>

        <HBox class="sapUiSmallMarginTop">
          <SearchField
            width="16rem"
            liveChange=".onEmailChange"
            placeholder="Search User / Client"/>
          <SearchField
            width="12rem"
            liveChange=".onIpChange"
            placeholder="Search IP"/>
        </HBox>

      </VBox>

    </Panel>

    <!-- SIDE BY SIDE FLEX CHARTS -->
    <FlexBox
      width="100%"
      renderType="Bare"
      wrap="NoWrap"
      justifyContent="SpaceBetween"
      class="sapUiContentPadding sapUiMediumMarginBottom">

      <!-- PIE PANEL -->
      <Panel>
        <layoutData>
          <FlexItemData growFactor="1" baseSize="50%"/>
        </layoutData>

        <viz:VizFrame
          id="idUserPie"
          width="100%"
          height="420px"
          vizType="pie"
          uiConfig="{applicationSet:'fiori'}"
          selectData=".onUserPieSelect"
          vizProperties='{
            "plotArea":{
              "dataLabel":{"visible":true}
            },
            "legend":{
              "visible":true,
              "layout":{"position":"bottom"}
            }
          }'>

          <viz:dataset>
            <vizData:FlattenedDataset
              data="{security>/userChart}">
              <vizData:dimensions>
                <vizData:DimensionDefinition
                  name="User"
                  value="{security>user}"/>
              </vizData:dimensions>
              <vizData:measures>
                <vizData:MeasureDefinition
                  name="Events"
                  value="{security>count}"/>
              </vizData:measures>
            </vizData:FlattenedDataset>
          </viz:dataset>

          <viz:feeds>
            <vizFeeds:FeedItem uid="size"
              type="Measure" values="Events"/>
            <vizFeeds:FeedItem uid="color"
              type="Dimension" values="User"/>
          </viz:feeds>

        </viz:VizFrame>
      </Panel>

      <!-- LINE PANEL -->
      <Panel>
        <layoutData>
          <FlexItemData growFactor="1" baseSize="50%"/>
        </layoutData>

        <viz:VizFrame
          id="idRiskLine"
          width="100%"
          height="420px"
          vizType="line"
          uiConfig="{applicationSet:'fiori'}"
          vizProperties='{
            "title":{
              "visible":true,
             "text":"IAM Activity by Hour of Day"
            }
          }'>

          <viz:dataset>
            <vizData:FlattenedDataset
              data="{security>/hourChart}">
              <vizData:dimensions>
                <vizData:DimensionDefinition
                  name="Time"
                  value="{security>time}"/>
              </vizData:dimensions>
              <vizData:measures>
                <vizData:MeasureDefinition
                  name="Risk Events"
                  value="{security>count}"/>
              </vizData:measures>
            </vizData:FlattenedDataset>
          </viz:dataset>

          <viz:feeds>
            <vizFeeds:FeedItem uid="valueAxis"
              type="Measure" values="Risk Events"/>
            <vizFeeds:FeedItem uid="categoryAxis"
              type="Dimension" values="Time"/>
          </viz:feeds>

        </viz:VizFrame>

      </Panel>

    </FlexBox>
<HBox
 justifyContent="End"
 class="sapUiSmallMarginBottom">

 <Button
  text="Export Security to Excel"
  icon="sap-icon://excel-attachment"
  type="Emphasized"
  press=".onExportSecurityExcel"/>

</HBox>

<!-- ================= LAST AUDIT ================= -->

<HBox
  width="100%"
  justifyContent="End"
  class="sapUiContentPadding sapUiMediumMarginTop sapUiMediumMarginBottom">

  <ObjectStatus
    title="Last Security Event Available"
    text="{security>/lastAuditDate}"
    state="Success"/>


</HBox>

    <!-- TABLE -->
    <Table
      items="{security>/rows}"
      growing="true"
      growingThreshold="25"
      class="sapUiContentPadding">

      <columns>
        <Column><Text text="Time"/></Column>
        <Column><Text text="User"/></Column>
        <Column><Text text="Risk"/></Column>
        <Column><Text text="Event Type"/></Column>
        <Column><Text text="IP"/></Column>
        <Column><Text text="Client"/></Column>
        <Column><Text text="Score"/></Column>
      </columns>

      <items>
        <ColumnListItem>
          <cells>

            <Text text="{security>time}"/>
            <Text text="{security>user}" wrapping="true"/>
            <ObjectStatus
              text="{security>risk}"
              state="{security>riskState}"/>
            <Text text="{security>eventType}"/>
            <Text text="{security>ip}"/>
            <Text text="{security>client}" wrapping="true"/>

            <ObjectNumber
              number="{
                path:'security>anomalyScore',
                type:'sap.ui.model.type.Float',
                formatOptions:{
                  minFractionDigits:3,
                  maxFractionDigits:3
                }
              }"/>

          </cells>
        </ColumnListItem>
      </items>

    </Table>

  </content>

</Page>

</mvc:View>