<mvc:View
  controllerName="pwc.monitoring.monitoringui.controller.Risk"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:viz="sap.viz.ui5.controls"
  xmlns:viz.data="sap.viz.ui5.data"
  xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
  xmlns:l="sap.ui.layout">

<Page title="AI Risk Monitoring">

<headerContent>
  <Button text="Refresh" press=".onRefresh"/>
  <Button text="Security Events" press=".onGoSecurity"/>
  <Button text="Data Changes" press=".onGoDataChanges"/>
  <Button text="System Health" press=".onGoSystemHealth"/>
</headerContent>

<content>

<!-- ================= KPI ================= -->

<l:Grid
 defaultSpan="XL3 L3 M6 S12"
 hSpacing="1"
 vSpacing="1"
 class="sapUiMediumMarginBottom">

  <GenericTile header="High Risk" press=".onRiskFilter">
    <customData>
      <core:CustomData key="risk" value="High"/>
    </customData>
    <TileContent>
      <NumericContent value="{logs>/highCount}" valueColor="Error"/>
    </TileContent>
  </GenericTile>

  <GenericTile header="Medium Risk" press=".onRiskFilter">
    <customData>
      <core:CustomData key="risk" value="Medium"/>
    </customData>
    <TileContent>
      <NumericContent value="{logs>/mediumCount}" valueColor="Critical"/>
    </TileContent>
  </GenericTile>

  <GenericTile header="Low Risk" press=".onRiskFilter">
    <customData>
      <core:CustomData key="risk" value="Low"/>
    </customData>
    <TileContent>
      <NumericContent value="{logs>/lowCount}" valueColor="Neutral"/>
    </TileContent>
  </GenericTile>

  <GenericTile header="Normal" press=".onRiskFilter">
    <customData>
      <core:CustomData key="risk" value="Normal"/>
    </customData>
    <TileContent>
      <NumericContent value="{logs>/normalCount}" valueColor="Good"/>
    </TileContent>
  </GenericTile>

</l:Grid>

<!-- ================= CHARTS ================= -->

<l:Grid class="sapUiMediumMarginTop"
 hSpacing="1"
 vSpacing="1">

  <!-- LINE -->
  <viz:VizFrame
    id="riskChart"
    vizType="line"
    width="100%"
    height="280px"
    vizProperties="{
      title:{visible:true,text:'Weekly Risk Trend'},
      interaction:{selectability:{mode:'single'}},
      valueAxis:{title:{visible:true,text:'Log Count'}},
      categoryAxis:{title:{visible:true,text:'ISO Week'}},
      plotArea:{dataLabel:{visible:false}}
    }">

    <viz:layoutData>
      <l:GridData span="XL8 L8 M12 S12"/>
    </viz:layoutData>

    <viz:dataset>
      <viz.data:FlattenedDataset data="{logs>/trendData}">
        <viz.data:dimensions>
          <viz.data:DimensionDefinition name="Week" value="{logs>week}"/>
        </viz.data:dimensions>
        <viz.data:measures>
          <viz.data:MeasureDefinition name="High" value="{logs>High}"/>
          <viz.data:MeasureDefinition name="Medium" value="{logs>Medium}"/>
          <viz.data:MeasureDefinition name="Low" value="{logs>Low}"/>
          <viz.data:MeasureDefinition name="Normal" value="{logs>Normal}"/>
        </viz.data:measures>
      </viz.data:FlattenedDataset>
    </viz:dataset>

    <viz:feeds>
      <viz.feeds:FeedItem uid="valueAxis"
        type="Measure"
        values="High,Medium,Low,Normal"/>
      <viz.feeds:FeedItem uid="categoryAxis"
        type="Dimension"
        values="Week"/>
    </viz:feeds>

  </viz:VizFrame>

  <!-- DONUT -->
  <viz:VizFrame
    vizType="donut"
    width="100%"
    height="280px"
    vizProperties="{
      title:{visible:true,text:'Risk Composition'},
      plotArea:{
        dataLabel:{visible:false},
        dataPointSize:{min:2}
      }
    }">

    <viz:layoutData>
      <l:GridData span="XL4 L4 M12 S12"/>
    </viz:layoutData>

    <viz:dataset>
      <viz.data:FlattenedDataset data="{logs>/pieData}">
        <viz.data:dimensions>
          <viz.data:DimensionDefinition
            name="Risk"
            value="{logs>risk}"/>
        </viz.data:dimensions>
        <viz.data:measures>
          <viz.data:MeasureDefinition
            name="%"
            value="{logs>value}"/>
        </viz.data:measures>
      </viz.data:FlattenedDataset>
    </viz:dataset>

    <viz:feeds>
      <viz.feeds:FeedItem uid="size"
        type="Measure"
        values="%"/>
      <viz.feeds:FeedItem uid="color"
        type="Dimension"
        values="Risk"/>
    </viz:feeds>

  </viz:VizFrame>

</l:Grid>

<!-- ================= LAST AUDIT ================= -->

<ObjectStatus
  class="sapUiSmallMarginTop"
  title="Last Audit Event Available"
  text="{logs>/lastAuditDate}"/>
<HBox
 justifyContent="End"
 class="sapUiSmallMarginEnd sapUiSmallMarginBottom">

 <Button
  text="Export to Excel"
  icon="sap-icon://excel-attachment"
  type="Emphasized"
  press=".onExportExcel"/>

</HBox>
<!-- ================= TABLE ================= -->

<Table
  id="riskTable"
  items="{logs>/logs}"
  growing="true"
  growingThreshold="20">
  <columns>
    <Column width="40%"><Text text="Role / Operation"/></Column>
    <Column width="20%"><Text text="Score"/></Column>
    <Column width="20%"><Text text="Risk"/></Column>
  </columns>

  <items>
    <ColumnListItem>
      <cells>
        <Text text="{path:'logs>details',formatter:'.formatOperation'}"/>
        <ObjectNumber
          number="{path:'logs>anomalyScore',formatter:'.formatScore'}"/>
        <ObjectStatus text="{logs>risk}" state="{logs>riskState}"/>
      </cells>
    </ColumnListItem>
  </items>
</Table>

</content>

</Page>
</mvc:View>
