<mvc:View
  controllerName="pwc.monitoring.monitoringui.controller.Risk"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:viz="sap.viz.ui5.controls"
  xmlns:vizData="sap.viz.ui5.data"
  xmlns:vizFeeds="sap.viz.ui5.controls.common.feeds"
  xmlns:l="sap.ui.layout">

  <Page
    title="AI Risk Monitoring"
    showNavButton="true"
    navButtonPress=".onBack">

    <headerContent>
      <Button text="Refresh" icon="sap-icon://refresh" type="Emphasized" press=".onRefresh"/>
      <Button text="Security Events" icon="sap-icon://shield" press=".onGoSecurity"/>
      <Button text="System Health" icon="sap-icon://sys-monitor" press=".onGoSystemHealth"/>
      <Button
    text="AI Recommendation"
    icon="sap-icon://lightbulb"
    type="Accept"
    press=".goKmeans"/>
    </headerContent>

    <content>
      <VBox class="sapUiContentPadding">

        <!-- Intro -->
        <MessageStrip
          text="Monitor AI-related operational risk levels, weekly trends, anomaly distribution, and affected role/activity patterns."
          type="Information"
          showIcon="true"
          class="sapUiSmallMarginBottom"/>

        <!-- ================= KPI ================= -->
        <HBox
          width="100%"
          justifyContent="SpaceAround"
          wrap="Wrap"
          class="sapUiMediumMarginBottom">

          <!-- High -->
          <VBox class="kpiCard kpiHigh" alignItems="Center" justifyContent="Center">
            <customData>
              <core:CustomData key="risk" value="High"/>
            </customData>
            <core:Icon src="sap-icon://warning2" size="1.6rem" class="kpiIcon"/>
            <Title text="High Risk" level="H6" class="kpiTitle"/>
            <ObjectNumber
              number="{logs>/highCount}"
              state="Error"
              class="kpiNumber"/>
          </VBox>

          <!-- Medium -->
          <VBox class="kpiCard kpiMedium" alignItems="Center" justifyContent="Center">
            <customData>
              <core:CustomData key="risk" value="Medium"/>
            </customData>
            <core:Icon src="sap-icon://alert" size="1.6rem" class="kpiIcon"/>
            <Title text="Medium Risk" level="H6" class="kpiTitle"/>
            <ObjectNumber
              number="{logs>/mediumCount}"
              state="Warning"
              class="kpiNumber"/>
          </VBox>

          <!-- Low -->
          <VBox class="kpiCard kpiLow" alignItems="Center" justifyContent="Center">
            <customData>
              <core:CustomData key="risk" value="Low"/>
            </customData>
            <core:Icon src="sap-icon://activity-individual" size="1.6rem" class="kpiIcon"/>
            <Title text="Low Risk" level="H6" class="kpiTitle"/>
            <ObjectNumber
              number="{logs>/lowCount}"
              state="Information"
              class="kpiNumber"/>
          </VBox>

          <!-- Normal -->
          <VBox class="kpiCard kpiNormal" alignItems="Center" justifyContent="Center">
            <customData>
              <core:CustomData key="risk" value="Normal"/>
            </customData>
            <core:Icon src="sap-icon://accept" size="1.6rem" class="kpiIcon"/>
            <Title text="Normal" level="H6" class="kpiTitle"/>
            <ObjectNumber
              number="{logs>/normalCount}"
              state="Success"
              class="kpiNumber"/>
          </VBox>

        </HBox>

        <!-- ================= CHARTS ================= -->
        <FlexBox
          width="100%"
          renderType="Bare"
          wrap="Wrap"
          justifyContent="SpaceBetween"
          class="sapUiMediumMarginBottom">

          <!-- LINE PANEL -->
          <Panel class="styledPanel chartPanel">
            <layoutData>
              <FlexItemData growFactor="2" baseSize="64%"/>
            </layoutData>

            <VBox class="sapUiMediumMargin">
              <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                <core:Icon src="sap-icon://line-chart" size="1.1rem" class="cardIconBlue sapUiTinyMarginEnd"/>
                <Title text="Weekly Risk Trend" level="H5"/>
              </HBox>

              <Text
                text="Track the weekly evolution of High, Medium, Low, and Normal AI risk events."
                class="subtleText sapUiTinyMarginBottom"/>

              <viz:VizFrame
                id="riskChart"
                vizType="line"
                width="100%"
                height="360px"
                uiConfig="{applicationSet:'fiori'}"
                vizProperties='{
                  "plotArea":{
                    "dataLabel":{"visible":false},
                    "colorPalette":["#dc2626","#d97706","#2563eb","#059669"]
                  },
                  "legend":{
                    "visible":true,
                    "layout":{"position":"bottom"}
                  },
                  "valueAxis":{"title":{"visible":true,"text":"Log Count"}},
                  "categoryAxis":{"title":{"visible":true,"text":"ISO Week"}},
                  "title":{"visible":false}
                }'>

                <viz:dataset>
                  <vizData:FlattenedDataset data="{logs>/trendData}">
                    <vizData:dimensions>
                      <vizData:DimensionDefinition name="Week" value="{logs>week}"/>
                    </vizData:dimensions>
                    <vizData:measures>
                      <vizData:MeasureDefinition name="High" value="{logs>High}"/>
                      <vizData:MeasureDefinition name="Medium" value="{logs>Medium}"/>
                      <vizData:MeasureDefinition name="Low" value="{logs>Low}"/>
                      <vizData:MeasureDefinition name="Normal" value="{logs>Normal}"/>
                    </vizData:measures>
                  </vizData:FlattenedDataset>
                </viz:dataset>

                <viz:feeds>
                  <vizFeeds:FeedItem uid="valueAxis" type="Measure" values="High,Medium,Low,Normal"/>
                  <vizFeeds:FeedItem uid="categoryAxis" type="Dimension" values="Week"/>
                </viz:feeds>
              </viz:VizFrame>
            </VBox>
          </Panel>

          <!-- DONUT PANEL -->
          <Panel class="styledPanel chartPanel">
            <layoutData>
              <FlexItemData growFactor="1" baseSize="33%"/>
            </layoutData>

            <VBox class="sapUiMediumMargin">
              <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                <core:Icon src="sap-icon://donut-chart" size="1.1rem" class="cardIconPurple sapUiTinyMarginEnd"/>
                <Title text="Risk Composition" level="H5"/>
              </HBox>

              <Text
                text="Visual distribution of current AI risk composition across all monitored events."
                class="subtleText sapUiTinyMarginBottom"/>

              <viz:VizFrame
                id="riskDonut"
                vizType="donut"
                width="100%"
                height="360px"
                uiConfig="{applicationSet:'fiori'}"
                vizProperties='{
                  "plotArea":{
                    "dataLabel":{"visible":true},
                    "colorPalette":["#dc2626","#d97706","#2563eb","#059669"]
                  },
                  "legend":{
                    "visible":true,
                    "layout":{"position":"bottom"}
                  },
                  "title":{"visible":false}
                }'>

                <viz:dataset>
                  <vizData:FlattenedDataset data="{logs>/pieData}">
                    <vizData:dimensions>
                      <vizData:DimensionDefinition name="Risk" value="{logs>risk}"/>
                    </vizData:dimensions>
                    <vizData:measures>
                      <vizData:MeasureDefinition name="Percentage" value="{logs>value}"/>
                    </vizData:measures>
                  </vizData:FlattenedDataset>
                </viz:dataset>

                <viz:feeds>
                  <vizFeeds:FeedItem uid="size" type="Measure" values="Percentage"/>
                  <vizFeeds:FeedItem uid="color" type="Dimension" values="Risk"/>
                </viz:feeds>
              </viz:VizFrame>
            </VBox>
          </Panel>

        </FlexBox>

        <!-- ================= ACTIONS / AUDIT ================= -->
        <HBox
          width="100%"
          justifyContent="SpaceBetween"
          alignItems="Center"
          class="sapUiSmallMarginBottom sapUiSmallMarginTop">

          <ObjectStatus
            title="Last Audit Event Available"
            text="{logs>/lastAuditDate}"
            state="Success"
            icon="sap-icon://history"/>

          <Button
            text="Export to Excel"
            icon="sap-icon://excel-attachment"
            type="Emphasized"
            press=".onExportExcel"/>
        </HBox>

        <!-- ================= TABLE PANEL ================= -->
        <Panel class="styledPanel">
          <VBox class="sapUiMediumMargin">
            <HBox alignItems="Center" class="sapUiSmallMarginBottom">
              <core:Icon src="sap-icon://table-view" size="1.1rem" class="cardIconGreen sapUiTinyMarginEnd"/>
              <Title text="AI Risk Events Table" level="H5"/>
            </HBox>

            <Text
              text="Detailed view of operations, anomaly score, and associated risk classification."
              class="subtleText sapUiSmallMarginBottom"/>

            <Table
              id="riskTable"
              items="{logs>/logs}"
              growing="true"
              growingThreshold="20"
              class="niceTable">

              <columns>
                <Column width="55%">
                  <Text text="Role / Operation"/>
                </Column>
                <Column width="20%" hAlign="End">
                  <Text text="Score"/>
                </Column>
                <Column width="25%">
                  <Text text="Risk"/>
                </Column>
              </columns>

              <items>
                <ColumnListItem class="tableRowHover">
                  <cells>
                    <Text text="{path:'logs>details', formatter:'.formatOperation'}" wrapping="true"/>
                    <ObjectNumber
                      number="{path:'logs>anomalyScore', formatter:'.formatScore'}"
                      emphasized="false"/>
                    <ObjectStatus
                      text="{logs>risk}"
                      state="{logs>riskState}"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </VBox>
        </Panel>

      </VBox>
    </content>

  </Page>
</mvc:View>