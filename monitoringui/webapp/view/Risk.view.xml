<mvc:View
  controllerName="pwc.monitoring.monitoringui.controller.Risk"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:viz="sap.viz.ui5.controls"
  xmlns:viz.data="sap.viz.ui5.data"
  xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">

<Page title="AI Risk Monitoring">
 <headerContent>
      <Button id="btnRefreshh" text="Refresh" press=".onRefresh"/>
      <Button id="btnGoSecurityy" text="Security Events" press=".onGoSecurity"/>
      <Button id="btnGoDataChangess" text="Data Changes" press=".onGoDataChanges"/>
      <Button text="System Health" press=".onGoSystemHealth" />
    </headerContent>
  <content>

    <!-- ================= FILTER TILES ================= -->

    <HBox justifyContent="SpaceAround" class="sapUiMediumMarginBottom">

      <GenericTile header="High Risk" press=".onRiskFilter">
        <customData>
          <core:CustomData key="risk" value="High"/>
        </customData>
        <TileContent>
          <NumericContent value="{logs>/highCount}" valueColor="Error"/>
        </TileContent>
      </GenericTile>

      <GenericTile header="Medium Risk" press=".onRiskFilter">
        <customData>
          <core:CustomData key="risk" value="Medium"/>
        </customData>
        <TileContent>
          <NumericContent value="{logs>/mediumCount}" valueColor="Critical"/>
        </TileContent>
      </GenericTile>

      <GenericTile header="Low Risk" press=".onRiskFilter">
        <customData>
          <core:CustomData key="risk" value="Low"/>
        </customData>
        <TileContent>
          <NumericContent value="{logs>/lowCount}" valueColor="Neutral"/>
        </TileContent>
      </GenericTile>

      <GenericTile header="Normal" press=".onRiskFilter">
        <customData>
          <core:CustomData key="risk" value="Normal"/>
        </customData>
        <TileContent>
          <NumericContent value="{logs>/normalCount}" valueColor="Good"/>
        </TileContent>
      </GenericTile>

    </HBox>

    <!-- ================= WEEKLY TREND LINE CHART ================= -->

    <VBox class="sapUiMediumMarginTop">

      <viz:VizFrame
        id="riskChart"
        vizType="line"
        width="100%"
        height="320px">

        <viz:dataset>
          <viz.data:FlattenedDataset data="{logs>/trendData}">

            <viz.data:dimensions>
              <viz.data:DimensionDefinition
                name="Week"
                value="{logs>date}"/>
            </viz.data:dimensions>

            <viz.data:measures>
              <viz.data:MeasureDefinition name="High" value="{logs>High}"/>
              <viz.data:MeasureDefinition name="Medium" value="{logs>Medium}"/>
              <viz.data:MeasureDefinition name="Low" value="{logs>Low}"/>
              <viz.data:MeasureDefinition name="Normal" value="{logs>Normal}"/>
            </viz.data:measures>

          </viz.data:FlattenedDataset>
        </viz:dataset>

        <viz:feeds>
          <viz.feeds:FeedItem
            uid="valueAxis"
            type="Measure"
            values="High,Medium,Low,Normal"/>
          <viz.feeds:FeedItem
            uid="categoryAxis"
            type="Dimension"
            values="Week"/>
        </viz:feeds>

      </viz:VizFrame>

    </VBox>

    <!-- ================= TABLE ================= -->

    <Table
      id="riskTable"
      items="{logs>/logs}"
      growing="true"
      growingThreshold="20"
      growingScrollToLoad="true">

      <columns>
        <Column width="40%">
          <Text text="Role / Operation"/>
        </Column>
        <Column width="20%">
          <Text text="Score"/>
        </Column>
        <Column width="20%">
          <Text text="Risk"/>
        </Column>
      </columns>

      <items>
        <ColumnListItem>
          <cells>

            <Text
              text="{
                path:'logs>details',
                formatter:'.formatOperation'
              }"
              wrapping="true"/>

            <ObjectNumber
              number="{
                path:'logs>anomalyScore',
                formatter:'.formatScore'
              }"/>

            <ObjectStatus
              text="{logs>risk}"
              state="{logs>riskState}"/>

          </cells>
        </ColumnListItem>
      </items>

    </Table>

  </content>

</Page>
</mvc:View>