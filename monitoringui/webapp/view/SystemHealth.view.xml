<mvc:View
  controllerName="pwc.monitoring.monitoringui.controller.SystemHealth"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:l="sap.ui.layout"
  xmlns:viz="sap.viz.ui5.controls"
  displayBlock="true">

  <Page title="System Observability Dashboard">

    <content>

      <l:Grid width="100%" class="sapUiLargeMargin">

        <!-- ============================= -->
        <!-- CPU CARD (HALF ROW) -->
        <!-- ============================= -->
        <f:Card>
          <f:layoutData>
            <l:GridData span="L6 M12 S12"/>
          </f:layoutData>

          <f:content>
            <VBox class="sapUiSmallMargin">
              <Title text="CPU Usage" level="H4"/>
              <ObjectStatus
                text="{metrics>/cpuText}"
                state="{metrics>/cpuState}"/>
              <Text
                text="Measures backend processing load."
                class="sapUiTinyMarginTop"/>

              <viz:VizFrame
                id="cpuChart"
                vizType="line"
                uiConfig="{applicationSet:'fiori'}"
                width="100%"
                height="180px"/>
            </VBox>
          </f:content>
        </f:Card>

        <!-- ============================= -->
        <!-- MEMORY CARD (HALF ROW) -->
        <!-- ============================= -->
        <f:Card>
          <f:layoutData>
            <l:GridData span="L6 M12 S12"/>
          </f:layoutData>

          <f:content>
            <VBox class="sapUiSmallMargin">
              <Title text="Memory (RSS)" level="H4"/>
              <ObjectStatus
                text="{metrics>/memText}"
                state="Information"/>
              <Text
                text="Total RAM used by Node.js."
                class="sapUiTinyMarginTop"/>

              <viz:VizFrame
                id="memChart"
                vizType="line"
                uiConfig="{applicationSet:'fiori'}"
                width="100%"
                height="180px"/>
            </VBox>
          </f:content>
        </f:Card>

        <!-- ============================= -->
        <!-- HEALTH -->
        <!-- ============================= -->
        <f:Card>
          <f:layoutData>
            <l:GridData span="L3 M6 S12"/>
          </f:layoutData>

          <f:content>
            <VBox class="sapUiSmallMargin">
              <Title text="Health Score" level="H4"/>
              <ObjectStatus
                text="{metrics>/healthText}"
                state="{metrics>/healthState}"/>
              <Text
                text="Overall runtime stability."
                class="sapUiTinyMarginTop"/>
            </VBox>
          </f:content>
        </f:Card>

        <!-- ============================= -->
        <!-- RESPONSE TIME -->
        <!-- ============================= -->
        <f:Card>
          <f:layoutData>
            <l:GridData span="L3 M6 S12"/>
          </f:layoutData>

          <f:content>
            <VBox class="sapUiSmallMargin">
              <Title text="Response Time" level="H4"/>
              <ObjectStatus
                text="{metrics>/respText}"
                state="{metrics>/respState}"/>
              <Text
                text="Backend execution latency."
                class="sapUiTinyMarginTop"/>
            </VBox>
          </f:content>
        </f:Card>

        <!-- ============================= -->
        <!-- EVENT LOOP -->
        <!-- ============================= -->
        <f:Card>
          <f:layoutData>
            <l:GridData span="L3 M6 S12"/>
          </f:layoutData>

          <f:content>
            <VBox class="sapUiSmallMargin">
              <Title text="Event Loop Lag" level="H4"/>
              <ObjectStatus
                text="{= ${metrics>/elLagMs} + ' ms'}"
                state="{metrics>/lagState}"/>
              <Text
                text="Node.js overload delay."
                class="sapUiTinyMarginTop"/>
            </VBox>
          </f:content>
        </f:Card>

        <!-- ============================= -->
        <!-- GC -->
        <!-- ============================= -->
        <f:Card>
          <f:layoutData>
            <l:GridData span="L3 M6 S12"/>
          </f:layoutData>

          <f:content>
            <VBox class="sapUiSmallMargin">
              <Title text="GC Duration" level="H4"/>
              <ObjectStatus
                text="{metrics>/gcText}"
                state="{metrics>/gcState}"/>
              <Text
                text="Garbage collector runtime."
                class="sapUiTinyMarginTop"/>
            </VBox>
          </f:content>
        </f:Card>

        <!-- ============================= -->
        <!-- HEAP -->
        <!-- ============================= -->
        <f:Card>
          <f:layoutData>
            <l:GridData span="L3 M6 S12"/>
          </f:layoutData>

          <f:content>
            <VBox class="sapUiSmallMargin">
              <Title text="Heap Growth Rate" level="H4"/>
              <ObjectStatus
                text="{metrics>/heapText}"
                state="{metrics>/heapState}"/>
              <Text
                text="Memory growth trend."
                class="sapUiTinyMarginTop"/>
            </VBox>
          </f:content>
        </f:Card>

        <!-- ============================= -->
        <!-- UPTIME -->
        <!-- ============================= -->
        <f:Card>
          <f:layoutData>
            <l:GridData span="L3 M6 S12"/>
          </f:layoutData>

          <f:content>
            <VBox class="sapUiSmallMargin">
              <Title text="Uptime" level="H4"/>
              <ObjectStatus
                text="{metrics>/uptimeText}"
                state="Success"/>
              <Text
                text="Backend running time."
                class="sapUiTinyMarginTop"/>
            </VBox>
          </f:content>
        </f:Card>

      </l:Grid>

    </content>

  </Page>

</mvc:View>
