{
  "sap.app": {
    "id": "pwc.monitoring.monitoringui",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    }
  },

  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },

  "sap.ui5": {

    "rootView": {
      "viewName": "pwc.monitoring.monitoringui.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },

    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },

    "dependencies": {
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.viz": {}
      }
    },

    "routing": {

      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "pwc.monitoring.monitoringui.view",
        "controlId": "mainApp",
        "controlAggregation": "pages",
        "async": true,
        "transition": "slide"
      },

      "routes": [
        {
          "pattern": "",
          "name": "logs",
          "target": "logs"
        },
        {
          "pattern": "security",
          "name": "security",
          "target": "security"
        },
        {
          "pattern": "datachanges",
          "name": "datachanges",
          "target": "datachanges"
        },
        {
          "pattern": "system",
          "name": "system",
          "target": "system"
        },
        {
          "pattern": "risk",
          "name": "risk",
          "target": "risk"
        },
        {
          "pattern": "kmeans",
          "name": "kmeans",
          "target": "kmeans"
        },
        {
          "pattern": "anomalies",
          "name": "anomalies",
          "target": "anomalies"
        }
      ],

      "targets": {
        "logs": {
          "viewName": "Logs",
          "viewLevel": 1
        },
        "security": {
          "viewName": "Security",
          "viewLevel": 1
        },
        "datachanges": {
          "viewName": "DataChanges",
          "viewLevel": 1
        },
        "system": {
          "viewName": "SystemHealth",
          "viewLevel": 1
        },
        "risk": {
          "viewName": "Risk",
          "viewLevel": 1
        },
        "kmeans": {
          "viewName": "kmeans",
          "viewLevel": 1
        },
        "anomalies": {
          "viewName": "Anomalies",
          "viewLevel": 1
        }
      }

    }

  }
}